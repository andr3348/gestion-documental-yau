// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  CITIZEN // Ciudadano que presenta trámites
  SECRETARY // Funcionario de un área municipal
  ADMIN // Administrador del sistema
}

enum TramiteStatus {
  PENDING // Recibido, esperando clasificación del LLM
  CLASSIFIED // LLM lo clasificó, asignado a un área
  IN_REVIEW // El funcionario lo tomó
  RESOLVED // Trámite atendido y cerrado
  REJECTED // Rechazado con motivo
}

enum NotificationChannel {
  EMAIL
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

// -------------------------------------------------------------
// USER
// Un solo modelo para ciudadanos, funcionarios y admins.
// El campo `role` determina qué puede hacer en el sistema.
// Los funcionarios tienen departmentId; los ciudadanos no.
// -------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullName     String
  dni          String  @unique
  phone        String?
  role         Role    @default(CITIZEN)

  // Solo aplica si role == SECRETARY: área a la que pertenece
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  tramites      Tramite[] // Trámites presentados (ciudadano)
  statusChanges StatusHistory[] // Cambios de estado que realizó (funcionario)
  notifications Notification[] // Notificaciones recibidas

  @@map("users")
}

// -------------------------------------------------------------
// DEPARTMENT — Áreas de la municipalidad
// Se pre-cargan con un seed. Son las etiquetas que el LLM
// usará para clasificar. El slug es lo que se le pasa al LLM
// como opción válida de clasificación.
// -------------------------------------------------------------

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique // e.g. "obras-publicas", "licencias", "social"
  description String? // Contexto para el prompt del LLM
  isActive    Boolean @default(true)

  officers User[] // Funcionarios asignados a esta área
  tramites Tramite[] // Trámites derivados a esta área

  @@map("departments")
}

// Áreas pre-cargadas via seed:
// - Obras Públicas        (obras-publicas)
// - Licencias y Comercio  (licencias-comercio)
// - Desarrollo Social     (desarrollo-social)
// - Rentas y Tributación  (rentas-tributacion)
// - Registro Civil        (registro-civil)
// - Medio Ambiente        (medio-ambiente)
// - Seguridad Ciudadana   (seguridad-ciudadana)
// - Secretaría General    (secretaria-general)  ← fallback

// -------------------------------------------------------------
// TRAMITE — Entidad central del sistema
// Ciclo de vida: PENDING → CLASSIFIED → IN_REVIEW → RESOLVED
// El LLM actúa entre PENDING y CLASSIFIED.
// -------------------------------------------------------------

model Tramite {
  id          String @id @default(uuid())
  title       String // Asunto del trámite (ej: "Solicitud de licencia de funcionamiento")
  description String // Texto libre del ciudadano — lo que el LLM lee

  status TramiteStatus @default(PENDING)

  // Quién lo presentó
  citizenId String
  citizen   User   @relation(fields: [citizenId], references: [id])

  // A qué área fue derivado (null hasta que el LLM clasifica)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Resultado del LLM
  aiConfidence  Float? // 0.0 – 1.0 — qué tan seguro estuvo el modelo
  aiRawResponse String? // JSON crudo devuelto por OpenRouter/Ollama, para auditoría

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  attachments   TramiteAttachment[]
  statusHistory StatusHistory[]
  notifications Notification[]

  @@map("tramites")
}

// -------------------------------------------------------------
// TRAMITE ATTACHMENT — Archivos adjuntos al trámite
// El ciudadano puede subir DNI, planos, recibos, etc.
// Se almacenan en S3 / local storage; aquí solo la URL.
// -------------------------------------------------------------

model TramiteAttachment {
  id        String  @id @default(uuid())
  tramiteId String
  tramite   Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  fileName  String
  fileUrl   String // URL del archivo en storage
  mimeType  String // "application/pdf", "image/jpeg", etc.
  sizeBytes Int

  uploadedAt DateTime @default(now())

  @@map("tramite_attachments")
}

// -------------------------------------------------------------
// STATUS HISTORY — Auditoría de cada cambio de estado
// Permite al ciudadano ver el historial completo de su trámite
// y al sistema generar notificaciones por cada transición.
// -------------------------------------------------------------

model StatusHistory {
  id        String  @id @default(uuid())
  tramiteId String
  tramite   Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  // Quién hizo el cambio (puede ser el sistema/LLM → null, o un funcionario)
  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id])

  fromStatus TramiteStatus
  toStatus   TramiteStatus
  comment    String? // Motivo del cambio (obligatorio si toStatus == REJECTED)

  changedAt DateTime @default(now())

  @@map("status_history")
}

// -------------------------------------------------------------
// NOTIFICATION — Emails enviados al ciudadano
// Se crea un registro por cada email que el sistema intenta
// enviar. Permite reintentos y auditoría de entregas.
// -------------------------------------------------------------

model Notification {
  id        String  @id @default(uuid())
  tramiteId String
  tramite   Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  channel        NotificationChannel @default(EMAIL)
  subject        String
  body           String // HTML del email
  deliveryStatus DeliveryStatus      @default(QUEUED)

  sentAt DateTime? // null hasta que Resend confirma el envío

  @@map("notifications")
}
